// C:\DataFlex Projects\FutbolWebApp\AppSrc\ZoomLiga.wo
// ZoomLiga
//


// =============================================================================
// RESPUESTAS TAREA LIGA (ZoomLiga.wo):
// 
// 1º Botón en Zoom liga que muestre los equipos de esa liga:
//    R: Se implementa mediante un cWebButton que usa 'NavigatePath' para 
//       abrir el selector de equipos filtrando por la liga actual.
//
// 2º En vez del botón, los equipos de esa liga (Grid):
//    R: Se integra un objeto cWebList cuyo Server es oequipo_DD, vinculando 
//       el DataDictionary de equipos al de ligas (Constrain).
// =============================================================================

Open liga
Open equipo

Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg
Use cWebButton.pkg
Use cWebList.pkg
Use cWebColumn.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd

Use SelectEquipo.wo

Object oZoomLiga is a cWebView
    Set piColumnCount to 12
    Set psCaption to "Detalle de la Liga"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtZoom
    Set pbShowCaption to False
    Set piMaxWidth to 1024

    Object oliga_DD is a cligaDataDictionary
    End_Object

    Object oequipo_DD is a cequipoDataDictionary
        Set DDO_Server to oliga_DD
        // Esto hace que el Grid: filtra equipos por la liga actual
        Set Constrain_file to liga.File_Number
    End_Object

    Set Main_DD to oliga_DD
    Set Server  to oliga_DD

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12

        Object oligaNombre is a cWebForm
            Entry_Item liga.Nombre
            Set piColumnSpan to 12
            Set psLabel to "Nombre de la Liga"
        End_Object

        // TAREA PARTE 1: Botón para ver equipos 
        Object oVerEquiposBtn is a cWebButton
            Set psCaption to "Ver equipos de esta liga"
            Set piColumnSpan to 6
            Set piColumnIndex to 0

            WebRegisterPath ntNavigateForward oSelectEquipo

            Procedure OnClick
                // Navegación simple: Al ir al selector de equipos, 
                // DataFlex pasará el contexto de la liga automáticamente 
                // si están relacionados en el DDO.
                Send NavigatePath
            End_Procedure
        End_Object

        // TAREA PARTE 2: Lista de equipos integrada 
        Object oEquiposGrid is a cWebList
            Set piColumnSpan to 12
            Set pbFillHeight to True
            Set psCaption to "Equipos en esta liga"
            Set Server to oequipo_DD
            
            Object oequipoNombre is a cWebColumn
                Entry_Item equipo.Nombre
                Set psCaption to "Equipo"
                Set piWidth to 300
            End_Object
        End_Object
    End_Object

    Object oActionGroup is a cWebMenuGroup
        Object oSaveBtn is a cWebMenuItem
            Set psCSSClass to "WebSaveMenuItem"
            Set psCaption to "Guardar"
            Procedure OnClick
                Send Request_Save
            End_Procedure
        End_Object
    End_Object

End_Object