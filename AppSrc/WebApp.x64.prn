38819>>>    Procedure SetActionButtons
38822>>>        tWebNavigateData NavigateData
38822>>>        tWebNavigateData NavigateData
38822>>>        Boolean bHasRecord
38822>>>        Handle hoDD
38822>>>
38822>>>        Get Server to hoDD
38823>>>        Get GetNavigateData to NavigateData
38824>>>        Get HasRecord of hoDD to bHasRecord
38825>>>
38825>>>        // let's hide all buttons and then Show the ones we want
38825>>>        WebSet pbRender of oEditBtn to False
38826>>>        WebSet pbRender of oSaveBtn to False
38827>>>        WebSet pbRender of oCancelChangesBtn to False
38828>>>        WebSet pbRender of oDeleteBtn to False
38829>>>
38829>>>        If (NavigateData.bReadOnly) Begin
38831>>>            WebSet pbRender of oEditBtn to True
38832>>>        End
38832>>>>
38832>>>        Else Begin
38833>>>            WebSet pbRender of oSaveBtn to True
38834>>>            WebSet pbRender of oCancelChangesBtn to True
38835>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38836>>>        End
38836>>>>
38836>>>    End_Procedure
