37653>>>        Procedure OnRowClick String sRowId
37656>>>            tWebNavigateData NavigateData
37656>>>            tWebNavigateData NavigateData
37656>>>            Get GetNavigateData to NavigateData
37657>>>
37657>>>            Case Begin
37657>>>                Case (NavigateData.eNavigateType = nfFromParent)
37659>>>                    Send NavigateForward of oZoomJugador Self
37660>>>                    Case Break
37661>>>
37661>>>                Case (NavigateData.eNavigateType = nfFromChild)
37664>>>                    Send NavigateClose Self
37665>>>                    Case Break
37666>>>
37666>>>                Case (NavigateData.eNavigateType = nfFromMain)
37669>>>                    Send NavigateClose Self
37670>>>                    Case Break
37671>>>
37671>>>                Case Else 
37671>>>                    Send NavigateForward of oZoomJugador Self
37672>>>            Case End
37672>>>        End_Procedure
