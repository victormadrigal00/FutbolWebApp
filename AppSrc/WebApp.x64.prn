38847>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38850>>>        Case Begin
38850>>>            Case (NavigateData.eNavigateType = nfFromMain)
38852>>>                // If from main, this is a propbably a main file Select to Zoom.
38852>>>                Case Break
38853>>>
38853>>>            Case (NavigateData.eNavigateType = nfFromParent)
38856>>>                // If from parent, this is a constrained drill down.
38856>>>                Case Break
38857>>>
38857>>>            Case (NavigateData.eNavigateType = nfFromChild)
38860>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38860>>>                Case Break
38861>>>
38861>>>            Case Else // must be nfUndefined
38861>>>
38861>>>        Case End
38861>>>
38861>>>        Send SetActionButtons
38862>>>
38862>>>    End_Procedure
38863>>>
38863>>>End_Object 
